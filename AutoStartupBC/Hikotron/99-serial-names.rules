# copy this file to /etc/udev/rules.d/99-serial-names.rules

# ORIENTATION is with the ethernet port to the RIGHT of the 4 USB ports

# ESP32 to be plugged in to TOP RIGHT USB port, is will be ttyUSB0
# CANABLE dongle to be in LOWER RIGHT USB port, must be a dongle that appears as ttyACMx
# RS485 dongle to be in TOP LEFT USB port, must be a dongle that appears as ttyACMx

SUBSYSTEM=="tty", ENV{ID_PATH}=="platform-fd500000.pcie-pci-0000:01:00.0-usb-0:1.2:1.0", SYMLINK+="ttyCANABLE"
SUBSYSTEM=="tty", ENV{ID_PATH}=="platform-fd500000.pcie-pci-0000:01:00.0-usb-0:1.3:1.0", SYMLINK+="ttyRS485"

# to check the names use ls -l /dev/tty*

